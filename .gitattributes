# Normalize line endings: LF in the repository, regardless of the contributor's OS.
* text=auto eol=lf

# Windows-only scripts must stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary

# Git hooks run under sh: must stay LF.
.githooks/* text eol=lf

# Copy to .env for local overrides. The default is offline fixture/demo mode.
DEVOPS_FIXTURE_MODE=1
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PAT=

# Optional
# WEB_PORT=5174
# SYNC_INTERVAL_SEC=300
# Concurrent read-only work item detail requests per sync. 1 = sequential (default), 4 = recommended opt-in, max 8.
# SYNC_DETAIL_WORKERS=1
# Opt-in disk-backed staging for the initial/full sync: peak memory stays flat instead of growing with the number of
# work items, at the cost of temporary disk (about 3x the cache size) and a little CPU. 0 = off (default), 1 = on.
# Needs POSIX file locking (Linux, macOS, the Docker image); on native Windows it is refused with an error.
# SYNC_CHUNKED=0
# Larger context closure is opt-in. Without this policy, MAX_CONTEXT_ITEMS stays at 25000.
# Both positive budgets are required: item count plus actual HTTP attempts per complete sync, including WIQL,
# detail, context, reconciliation/probe calls and retries. Main-read exhaustion errors without publishing; later
# closure/reconciliation exhaustion remains partial and never advances the watermark or completion markers.
# SYNC_CONTEXT_POLICY=budgeted
# SYNC_CONTEXT_MAX_ITEMS=350000
# SYNC_CONTEXT_MAX_REQUESTS=2500
# DISABLE_BACKGROUND_SYNC=1

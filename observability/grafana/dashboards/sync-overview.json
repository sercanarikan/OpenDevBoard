{
  "uid": "opendev-sync-overview",
  "title": "OpenDevBoard Sync Overview",
  "tags": [
    "opendevboard",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Last successful sync (UTC timestamp)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opendevboard_last_successful_sync_timestamp_seconds * 1000",
          "legendFormat": "{{result}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Full syncs (selected range)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(opendevboard_sync_runs_total{mode=\"full\"}[$__range])) or vector(0)",
          "legendFormat": "full",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(increase(opendevboard_sync_runs_total{mode=\"incremental\"}[$__range])) or vector(0)",
          "legendFormat": "incremental",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Sync outcomes (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(increase(opendevboard_sync_runs_total{status=\"success\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(increase(opendevboard_sync_runs_total[$__rate_interval])) or vector(0)), 1)",
          "legendFormat": "success",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "100 * (sum(increase(opendevboard_sync_runs_total{status=\"partial\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(increase(opendevboard_sync_runs_total[$__rate_interval])) or vector(0)), 1)",
          "legendFormat": "partial",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "100 * (sum(increase(opendevboard_sync_runs_total{status=\"error\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(increase(opendevboard_sync_runs_total[$__rate_interval])) or vector(0)), 1)",
          "legendFormat": "error",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Sync duration P50 / P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(opendevboard_sync_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(opendevboard_sync_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Scheduler backoff",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opendevboard_scheduler_backoff_seconds",
          "legendFormat": "{{result}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Context closure dirty",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opendevboard_closure_dirty",
          "legendFormat": "{{result}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}

{
  "uid": "opendev-azure-http",
  "title": "OpenDevBoard Azure DevOps HTTP",
  "tags": [
    "opendevboard",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "HTTP attempts / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(opendevboard_http_attempts_total[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Retries / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(opendevboard_http_retries_total[$__rate_interval]) or vector(0)",
          "legendFormat": "{{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Retry / attempt ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(opendevboard_http_retries_total[$__rate_interval])) / clamp_min(sum(rate(opendevboard_http_attempts_total[$__rate_interval])), 1e-9)",
          "legendFormat": "{{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP 429 / 503 per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(opendevboard_http_results_total{result=\"429\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "429",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(rate(opendevboard_http_results_total{result=\"503\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "503",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP error rate / attempt",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(opendevboard_http_results_total{result=~\"4xx|5xx|network\"}[$__rate_interval])) / clamp_min(sum(rate(opendevboard_http_attempts_total[$__rate_interval])), 1e-9)",
          "legendFormat": "errors / attempts",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "WIQL calls / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opendevboard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(opendevboard_wiql_calls_total[$__rate_interval]) or vector(0)",
          "legendFormat": "{{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}
